# ===================================
# INTELYA HAVEN - Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ===================================

# Django
SECRET_KEY=change-this-to-a-very-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
DB_NAME=intelya_db
DB_USER=intelya_user
DB_PASSWORD=intelya_password_strong
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AWS S3 (Stockage photos, vidéos, PDFs, CNI)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=intelya-haven-storage
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_CUSTOM_DOMAIN=

# Firebase (Push Notifications FCM)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_PROJECT_ID=intelya-haven

# SMS (API Professeur)
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api-sms-professeur.com/send
SMS_SENDER_NAME=INTELYA

# Paiements - Orange Money (API Professeur)
ORANGE_MONEY_API_KEY=your-orange-money-key
ORANGE_MONEY_API_URL=https://api.orange-money.cm
ORANGE_MONEY_MERCHANT_ID=your-merchant-id

# Paiements - MTN Mobile Money (API Professeur)
MTN_MOMO_API_KEY=your-mtn-momo-key
MTN_MOMO_API_URL=https://api.mtn-momo.cm
MTN_MOMO_SUBSCRIPTION_KEY=your-subscription-key

# Paiements - Comptes Bancaires (API Professeur)
BANK_API_KEY=your-bank-api-key
BANK_API_URL=https://api-bancaire-professeur.com

# Smile Identity (Vérification CNI)
SMILE_IDENTITY_API_KEY=your-smile-identity-key
SMILE_IDENTITY_PARTNER_ID=your-partner-id

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@intelya-haven.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=INTELYA HAVEN <noreply@intelya-haven.com>

# Frontend URL (pour les liens dans les emails)
FRONTEND_URL=http://localhost:5173

# Sentry (Monitoring erreurs)
SENTRY_DSN=your-sentry-dsn

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign-In
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# Plateforme
PLATFORM_COMMISSION_PERCENT=2
PLATFORM_NAME=INTELYA HAVEN
PLATFORM_CURRENCY=FCFA

# Sécurité
MAX_LOGIN_ATTEMPTS=5
OTP_EXPIRY_MINUTES=15
VISIT_GPS_RADIUS_METERS=200
VISIT_CONFIRMATION_HOURS=24
DEBT_GRACE_DAYS_ALERT=3
DEBT_GRACE_DAYS_CLAIM=7
DEBT_GRACE_DAYS_ADMIN=15
DEBT_GRACE_DAYS_BLOCK=30
LEASE_RENEWAL_PERCENT=83
